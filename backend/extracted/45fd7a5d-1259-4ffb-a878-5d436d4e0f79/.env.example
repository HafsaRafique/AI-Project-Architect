# Copy this to .env (or export these in your shell / hosting platform's
# environment variable settings) and fill in what you need.

# Which backend narrates moves: "ollama" or "huggingface"
LLM_PROVIDER=huggingface

# --- Ollama (self-hosted, local) ---
# Only used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Hugging Face Inference Providers (cloud, no local machine needed) ---
# Only used when LLM_PROVIDER=huggingface
# Get a token at https://huggingface.co/settings/tokens
# (fine-grained token with "Make calls to Inference Providers" permission)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Flask
PORT=5000
